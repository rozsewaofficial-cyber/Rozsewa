{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 5000
    },
    {
      "name": "backend-local-db",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/scripts/devLocalDb.js"
      ],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "backend-offer-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/scripts/devLocalDb.js"
      ],
      "port": 5050
    },
    {
      "name": "backend-insta-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/scripts/devLocalDb.js"
      ],
      "port": 5050
    },
    {
      "name": "frontend-api5050",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=http://localhost:5050/api&& npm --prefix frontend run dev"
      ],
      "port": 8080
    },
    {
      "name": "backend-5051",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set LOCAL_PORT=5051&& node backend/scripts/devLocalDb.js"
      ],
      "port": 5051,
      "autoPort": false
    },
    {
      "name": "frontend-api5051",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=http://localhost:5051/api&& npm --prefix frontend run dev"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "frontend-api5002",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=http://localhost:5002/api&& npm --prefix frontend run dev"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "frontend-api5001",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=http://localhost:5001/api&& npm --prefix frontend run dev"
      ],
      "port": 8080,
      "autoPort": false
    }
  ]
}